rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "khalidfairooz4321@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /cinemaVideos/{videoId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          "title", "actorName", "actorImage", "posterUrl", "description",
          "driveUrl", "likes", "createdAt", "createdBy"
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.driveUrl is string
        && request.resource.data.likes == 0;
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likes"])
        && request.resource.data.likes is int
        && request.resource.data.likes >= resource.data.likes
      );
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(["text", "createdAt"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 350;
        allow update, delete: if isAdmin();
      }
    }
  }
}
